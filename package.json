{
  "name": "our-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mobile": "NEXT_DIST_DIR=.next-mobile NEXT_PUBLIC_SUPABASE_URL=http://localhost:54329 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test_only next build && playwright test -c playwright.mobile.config.ts",
    "check:env": "node scripts/check-public-env.mjs",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:env && npm run test && npm run build && npm run scan:bundle",
    "test:rls": "bash scripts/db-test.sh",
    "test:supabase": "bash scripts/supabase-test.sh run",
    "test:rls:remote": "NODE_USE_ENV_PROXY=1 vitest run --config vitest.rls.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "29.1.1",
    "pg": "8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
